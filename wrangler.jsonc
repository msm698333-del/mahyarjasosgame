// پیکربندی Cloudflare برای «بازی جاسوس»
// استقرار: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mahyarjasos",
  "main": "worker/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // فرانت React پس از build در dist/client قرار می‌گیرد و همان Worker آن را سرو می‌کند
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // هر لابی = یک نمونه GameRoomDO (کد لابی = نام DO)
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoomDO" },
      { "name": "PLAYER_QUOTA", "class_name": "PlayerQuotaDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["PlayerQuotaDO"] }
  ],

  // تاریخچهٔ بازی‌ها (D1) کاملاً اختیاری است — بازی بدون آن هم کامل کار می‌کند.
  // برای فعال‌سازی بعدی این بلوک را از حالت کامنت خارج کنید:
  //   ۱) npx wrangler d1 create spy-game-db
  //   ۲) شناسهٔ خروجی را جای «DATABASE_ID_HERE» بگذارید
  //   ۳) npx wrangler d1 execute spy-game-db --remote --file migrations/0001_init.sql
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "spy-game-db",
  //     "database_id": "DATABASE_ID_HERE",
  //     "migrations_dir": "migrations"
  //   }
  // ],

  "observability": { "enabled": true }

  // Secrets اختیاری TURN (برای شبکه‌های سخت‌گیر):
  //   npx wrangler secret put TURN_URLS      مثال: turn:turn.cloudflare.com:3478?transport=udp
  //   npx wrangler secret put TURN_USERNAME
  //   npx wrangler secret put TURN_CREDENTIAL
  // بدون این Secrets، بازی فقط با STUN کار می‌کند و در اکثر شبکه‌ها کافی است.
}
